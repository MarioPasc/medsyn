  dist:
    enabled: true  # Set to true to enable multi-GPU distributed training
    backend: nccl  # Use 'nccl' for GPU training (fastest), 'gloo' for CPU
    num_gpus: auto  # 'auto' uses all available GPUs (set by torchrun)
    find_unused_parameters: false  # Set to true only if you have conditional/dynamic graph
    broadcast_buffers: true  # Sync batch norm stats across GPUs
    grad_accum_steps: 1  # Gradient accumulation steps (1 = no accumulation)
    seed_offset: 0  # Offset for per-rank seed decorrelation



